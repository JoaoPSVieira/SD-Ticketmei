+# Timeout do Inventory nos testes, e quanto o Inventory falso demora no modo "slow"
+INVENTORY_TEST_TIMEOUT = 0.3
+INVENTORY_SLOW_SECONDS = 0.6
+INITIAL_STOCK = {"evt-101": 100, "evt-104": 3}
